rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ポケふたマスタデータ: 書き込みはCloud Functions(Admin SDK)のみ。クライアントからは読み取り専用。
    match /manholes/{manholeId} {
      allow read: if isSignedIn();
      allow write: if false;

      // チェックイン写真: 本人のみ作成、削除は本人のみ。承認/却下(moderationStatus)はAdmin SDKのみ更新可。
      match /photos/{photoId} {
        allow read: if isSignedIn();
        allow create: if isOwner(request.resource.data.userId)
                       && request.resource.data.moderationStatus == 'pending';
        allow update: if false;
        allow delete: if isOwner(resource.data.userId);
      }

      // 周辺のおすすめスポット/飲食店レビュー
      match /spots/{spotId} {
        allow read: if isSignedIn();
        allow create: if isOwner(request.resource.data.userId)
                       && request.resource.data.rating is int
                       && request.resource.data.rating >= 1
                       && request.resource.data.rating <= 5;
        allow update, delete: if isOwner(resource.data.userId);
      }
    }

    // チェックイン履歴: 本人のみ読み書き
    match /checkins/{checkinId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if false;
    }

    // ユーザープロフィール: displayNameは他ユーザーからも参照可能(投稿者名表示のため)、書き込みは本人のみ
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
  }
}
